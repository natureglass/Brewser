{
  "name": "switch-web-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Switch homebrew browser shell built on @switch-web/runtime. Currently a minimal scaffold.",
  "scripts": {
    "build": "esbuild --bundle --sourcemap --sources-content=false --target=es2022 --format=esm --outdir=romfs src/main.ts",
    "sync-khronos": "node scripts/sync-khronos-tests.mjs",
    "nro": "node scripts/sync-khronos-tests.mjs && node scripts/build-icon.mjs && nxjs-nro",
    "nsp": "nxjs-nsp",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "author": {
    "name": "Alex Daskalakis",
    "email": "alexdaskalakis@hotmail.com"
  },
  "dependencies": {
    "@switch-web/runtime": "file:../switch-web-runtime",
    "css-tree": "^3.2.1"
  },
  "devDependencies": {
    "@nx.js/nro": "^0.0.70",
    "@nx.js/nsp": "^0.0.70",
    "@nx.js/runtime": "^0.0.70",
    "@types/css-tree": "^2.3.11",
    "esbuild": "^0.27.3"
  },
  "nacp": {
    "id": "01f5905036d20000"
  }
}
